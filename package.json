{
  "name": "helius-indexer-test",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Small learning tests for a reliable Solana token-transfer indexer.",
  "scripts": {
    "test:rpc": "node --import tsx src/01-rpc-test.ts",
    "test:block": "node --import tsx src/02-block-test.ts",
    "test:parser": "node --import tsx src/03-parser-test.ts",
    "test:parser:real": "node --import tsx src/03b-real-parser-test.ts",
    "test:db": "node --import tsx src/04-db-test.ts",
    "test:laserstream": "node --import tsx src/05-laserstream-test.ts",
    "test:laserstream:ws": "node --import tsx src/05b-laserstream-websocket-test.ts",
    "test:replay": "node --import tsx src/06-replay-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@solana/web3.js": "1.98.4",
    "dotenv": "17.4.2",
    "helius-laserstream": "^0.8.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.12",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
